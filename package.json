{
  "name": "palique",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop instant messenger inspired by MSN Messenger and AIM",
  "main": "./out/main/index.js",
  "author": {
    "name": "Paulo Ferreira",
    "email": "203633342+pauferr@users.noreply.github.com"
  },
  "homepage": "https://github.com/pauferr/palique",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauferr/palique.git"
  },
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "check:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-auth.ts",
    "check:roster": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-roster.ts",
    "check:chat": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-chat.ts",
    "check:history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-history.ts",
    "check:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-export.ts",
    "check:settings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-settings.ts",
    "check:presence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-presence.ts",
    "check:avatar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-avatar.ts",
    "check:emoticons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-emoticons.ts",
    "check:invisible": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-invisible.ts",
    "check:cooldown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-cooldown.ts",
    "check:invites": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-invites.ts",
    "check:email": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-email.ts",
    "check:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-reset.ts",
    "check:newsletter": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-newsletter.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@xmpp/client": "^0.14.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.19.1",
    "@types/xmpp__client": "^0.14.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
