# Copy to deploy/.env on the server and fill it in (docs/despliegue.md). Never commit .env.

# Public name of the server (DuckDNS subdomain or your own domain). Accounts look like
# tere@PALIQUE_DOMAIN. Its DNS must point to this server before running setup.sh.
PALIQUE_DOMAIN=palique.duckdns.org

# For Let's Encrypt notices about the certificate.
ACME_EMAIL=tu@correo.com

# Outgoing email through Brevo (Brevo > SMTP & API > SMTP). MAIL_FROM must be a sender
# verified in Brevo (Senders, domains & IPs).
SMTP_USER=
SMTP_PASS=
# Quoted: setup.sh also reads this file with bash.
MAIL_FROM="Palique <tu@correo.com>"
# Where replies go (optional; empty means back to MAIL_FROM).
MAIL_REPLY_TO=

# Newsletter list (optional; leave empty to store choices without syncing).
BREVO_API_KEY=
BREVO_LIST_ID=

# Generated by setup.sh if empty.
CUENTAS_SECRET=
BREVO_WEBHOOK_TOKEN=
