# Copy to deploy/.env on the server and fill it in (docs/deployment.md). Never commit .env.

# Public name of the server. Accounts look like tere@PALIQUE_DOMAIN. Its DNS must point to
# this server before running setup.sh.
PALIQUE_DOMAIN=tu-dominio.com

# For Let's Encrypt notices about the certificate.
ACME_EMAIL=tu@correo.com

# Outgoing email (any SMTP server). MAIL_FROM must be an address that server may send as,
# on a domain with SPF and DKIM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quoted: setup.sh also reads this file with bash.
MAIL_FROM="Palique <hola@tu-dominio.com>"
# Where replies go (optional; empty means back to MAIL_FROM).
MAIL_REPLY_TO=

# Oldest app that may sign in (e.g. 0.9.0); empty lets every version in. Raise it only
# when a change breaks older apps: they're asked to download the new one.
MIN_APP_VERSION=

# Generated by setup.sh if empty.
ACCOUNTS_SECRET=
